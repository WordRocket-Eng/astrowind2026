---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Header ******************* -->

  <Hero>
    <Fragment slot="bg">
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-[3px] bg-primary"></div>
      </div>
    </Fragment>

    <Fragment slot="title">Services</Fragment>
    <Fragment slot="subtitle">
      EIKON Guyana Inc. delivers integrated engineering, construction, and green energy solutions across Guyana.
    </Fragment>
  </Hero>

  <!-- Full 8-service grid ******************* -->

  <Features
    id="services-grid"
    columns={3}
    items={[
      {
        title: 'Engineering Design & Consultancy',
        description:
          'Professional engineering design and consultancy services for infrastructure and construction projects.',
        icon: 'tabler:compass',
      },
      {
        title: 'Power Generation Solutions & Supervision',
        description:
          'Installation, maintenance, and rapid-response repair of generator systems, backed by Caterpillar Marine Analyst certification and 40+ years of combined experience.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Highway & Road Construction',
        description:
          "Full-scope road infrastructure, from site preparation and sub-base to asphalt paving and finishing, built to Guyana's national highway standards.",
        icon: 'tabler:road',
      },
      {
        title: 'Building Design, Construction & Consultancy',
        description:
          'Structural design, civil works, and turnkey building construction for commercial, industrial, and residential projects.',
        icon: 'tabler:building',
      },
      {
        title: 'Net-Zero Building Design (Solar & Wind)',
        description:
          "Grid-tied and off-grid renewable energy systems, solar arrays, wind turbines, and hybrid configurations engineered for Guyana's climate.",
        icon: 'tabler:sun',
      },
      {
        title: 'Schools & Public Infrastructure',
        description:
          'Construction and rehabilitation of schools and other public infrastructure buildings.',
        icon: 'tabler:school',
      },
      {
        title: 'Drainage & Irrigation Structures',
        description:
          'Design and construction of drainage and irrigation infrastructure.',
        icon: 'tabler:pipeline',
      },
      {
        title: 'Water Distribution & Wells',
        description:
          'Water distribution network and well construction services.',
        icon: 'tabler:droplet',
      },
    ]}
  >
    <Fragment slot="title">What We Do</Fragment>
    <Fragment slot="subtitle">
      Eight integrated service lines covering Guyana's core infrastructure and energy needs.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-slate-700"></div>
    </Fragment>
  </Features>

  <!-- Anchor targets for footer links ******************* -->

  <div id="engineering-design" class="scroll-mt-24"></div>
  <div id="power-generation" class="scroll-mt-24"></div>
  <div id="highway-road-construction" class="scroll-mt-24"></div>
  <div id="building-design-construction" class="scroll-mt-24"></div>
  <div id="net-zero-solar-wind" class="scroll-mt-24"></div>
  <div id="schools-public-infrastructure" class="scroll-mt-24"></div>
  <div id="drainage-irrigation" class="scroll-mt-24"></div>
  <div id="water-distribution" class="scroll-mt-24"></div>

  <!-- Closing CTA ******************* -->

  <CallToAction
    id="closing-cta"
    actions={[
      { text: 'Request a Quote', href: '/contact', variant: 'primary' },
    ]}
  >
    <Fragment slot="title">Let's Build Something That Lasts</Fragment>
    <Fragment slot="subtitle">
      From power generation to road infrastructure to renewable energy — EIKON Guyana Inc. has the engineering
      expertise and rapid-response capability to deliver. Get in touch to discuss your project.
    </Fragment>
  </CallToAction>
</Layout>
