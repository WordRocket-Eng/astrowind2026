---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Header ******************* -->

  <Hero>
    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-30"
        style="background-image: url('https://images.pexels.com/photos/12230651/pexels-photo-12230651.jpeg?auto=compress&cs=tinysrgb&w=1600')"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#141414]/80 via-[#141414]/90 to-[#141414]"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-[3px] bg-primary"></div>
    </Fragment>

    <Fragment slot="title">Services</Fragment>
    <Fragment slot="subtitle">
      EIKON Guyana Inc. delivers integrated engineering, construction, and energy solutions across Guyana.
    </Fragment>
  </Hero>

  <!-- Service Overview ******************* -->

  <section
    class="relative not-prose overflow-hidden border-b border-gray-200 bg-[#f7f7f5] dark:border-slate-700 dark:bg-[#181818]"
  >
    <div class="relative max-w-7xl mx-auto grid md:grid-cols-2 items-stretch">
      <div class="flex flex-col justify-center px-4 sm:px-6 py-16 md:py-24 lg:pr-20">
        <p class="text-primary font-bold tracking-[0.18em] uppercase text-xs mb-3">Integrated Delivery</p>
        <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tighter leading-tight mb-5">
          The right expertise for work that has to perform.
        </h2>
        <p class="text-lg text-muted dark:text-slate-400 leading-relaxed mb-7">
          From early design and technical consultancy to construction, installation, and maintenance, EIKON brings the
          right disciplines together around the needs of each project.
        </p>
        <a href="/contact" class="btn btn-primary self-start font-semibold">Discuss Your Project</a>
      </div>
      <div
        class="min-h-[360px] bg-cover bg-center"
        style="background-image: url('https://images.pexels.com/photos/159358/construction-site-build-construction-work-159358.jpeg?auto=compress&cs=tinysrgb&w=1400')"
        role="img"
        aria-label="Construction site with heavy equipment"
      >
      </div>
    </div>
  </section>

  <section class="relative not-prose bg-white dark:bg-[#141414]">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <a
          href="#power-generation"
          class="group relative min-h-[250px] overflow-hidden rounded-2xl bg-cover bg-center p-6 flex flex-col justify-end"
          style="background-image: url('https://images.pexels.com/photos/433308/pexels-photo-433308.jpeg?auto=compress&cs=tinysrgb&w=1000')"
        >
          <span
            class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/5 transition group-hover:from-black/95"
          ></span>
          <span class="relative z-10 text-white"
            ><span class="block text-primary text-xs font-bold uppercase tracking-[0.18em] mb-2"
              >Power &amp; Energy</span
            ><span class="font-heading text-2xl font-bold">Keep critical systems ready.</span></span
          >
        </a>
        <a
          href="#highway-road-construction"
          class="group relative min-h-[250px] overflow-hidden rounded-2xl bg-cover bg-center p-6 flex flex-col justify-end"
          style="background-image: url('https://images.pexels.com/photos/2101137/pexels-photo-2101137.jpeg?auto=compress&cs=tinysrgb&w=1000')"
        >
          <span
            class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/5 transition group-hover:from-black/95"
          ></span>
          <span class="relative z-10 text-white"
            ><span class="block text-primary text-xs font-bold uppercase tracking-[0.18em] mb-2">Civil Works</span><span
              class="font-heading text-2xl font-bold">Build routes that connect.</span
            ></span
          >
        </a>
        <a
          href="#building-design-construction"
          class="group relative min-h-[250px] overflow-hidden rounded-2xl bg-cover bg-center p-6 flex flex-col justify-end"
          style="background-image: url('https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=1000')"
        >
          <span
            class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/5 transition group-hover:from-black/95"
          ></span>
          <span class="relative z-10 text-white"
            ><span class="block text-primary text-xs font-bold uppercase tracking-[0.18em] mb-2"
              >Buildings &amp; Design</span
            ><span class="font-heading text-2xl font-bold">Turn plans into places.</span></span
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Full 8-service grid ******************* -->

  <Features
    id="services-grid"
    columns={3}
    items={[
      {
        title: 'Engineering Design & Consultancy',
        description:
          'Professional engineering design and consultancy services for infrastructure and construction projects.',
        icon: 'tabler:compass',
      },
      {
        title: 'Power Generation Solutions & Supervision',
        description:
          'The configuration, sourcing, supply and installation of power systems for generation, transmission and distribution and grid maintenance.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Highway & Road Construction',
        description:
          "Full-scope road infrastructure, from site preparation and sub-base to asphalt paving and finishing, built to Guyana's national highway standards.",
        icon: 'tabler:road',
      },
      {
        title: 'Building Design, Construction & Consultancy',
        description:
          'Structural design, civil works, and turnkey building construction for commercial, industrial, and residential projects.',
        icon: 'tabler:building',
      },
      {
        title: 'Net-Zero Building Design (Solar & Wind)',
        description:
          "Grid-tied and off-grid renewable energy systems, solar arrays, wind turbines, and hybrid configurations engineered for Guyana's climate.",
        icon: 'tabler:sun',
      },
      {
        title: 'Schools & Public Infrastructure',
        description: 'Construction and rehabilitation of schools and other public infrastructure buildings.',
        icon: 'tabler:school',
      },
      {
        title: 'Drainage & Irrigation Structures',
        description: 'Design and construction of drainage and irrigation infrastructure.',
        icon: 'tabler:pipeline',
      },
      {
        title: 'Water Distribution & Wells',
        description: 'Water distribution network and well construction services.',
        icon: 'tabler:droplet',
      },
    ]}
  >
    <Fragment slot="title">What We Do</Fragment>
    <Fragment slot="subtitle">
      Eight integrated service lines covering Guyana's core infrastructure and energy needs.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-slate-700">
      </div>
    </Fragment>
  </Features>

  <!-- Anchor targets for footer links ******************* -->

  <div id="engineering-design" class="scroll-mt-24"></div>
  <div id="power-generation" class="scroll-mt-24"></div>
  <div id="highway-road-construction" class="scroll-mt-24"></div>
  <div id="building-design-construction" class="scroll-mt-24"></div>
  <div id="net-zero-solar-wind" class="scroll-mt-24"></div>
  <div id="schools-public-infrastructure" class="scroll-mt-24"></div>
  <div id="drainage-irrigation" class="scroll-mt-24"></div>
  <div id="water-distribution" class="scroll-mt-24"></div>

  <!-- Closing CTA ******************* -->

  <CallToAction id="closing-cta" actions={[{ text: 'Request a Quote', href: '/contact', variant: 'primary' }]}>
    <Fragment slot="title">Let's Build Something That Lasts</Fragment>
    <Fragment slot="subtitle">
      From power generation to road infrastructure to renewable energy — EIKON Guyana Inc. has the engineering expertise
      and rapid-response capability to deliver. Get in touch to discuss your project.
    </Fragment>
  </CallToAction>
</Layout>
