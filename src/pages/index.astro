---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import GeometricAccent from '~/components/common/GeometricAccent.astro';

const metadata = {
  title: 'EIKON Guyana Inc.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero ******************* -->

  <Hero>
    <Fragment slot="bg">
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[6px] md:h-[10px] z-10">
          <GeometricAccent variant="full" class="h-full" />
        </div>
        <div class="absolute top-[6px] md:top-[10px] left-0 right-0 h-full opacity-[0.07]">
          <GeometricAccent variant="corner" class="w-[600px] md:w-[900px] -translate-x-1/4 translate-y-0" />
        </div>
      </div>
    </Fragment>

    <Fragment slot="title">
      Innovative Ideas,<br />Solutions & Results
    </Fragment>

    <Fragment slot="subtitle">
      EIKON Guyana Inc. delivers engineering, construction, and green energy solutions across Guyana — from
      power generation and highway construction to building design, net-zero solar and wind systems, drainage
      and irrigation, and water distribution.
    </Fragment>

    <Fragment slot="actions">
      <a
        href="/contact"
        class="btn btn-primary w-full sm:w-auto sm:mb-0 font-semibold text-base px-7 py-3.5"
      >
        Request a Quote
      </a>
      <a
        href="/services"
        class="btn w-full sm:w-auto sm:mb-0 font-semibold text-base px-7 py-3.5 text-white border-white/40 hover:bg-white/10 hover:border-white"
      >
        Our Services
      </a>
    </Fragment>
  </Hero>
</Layout>
