---
import { Icon } from 'astro-icon/components';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>
  <!-- Header ******************* -->

  <Hero>
    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-cover bg-center opacity-30"
        style="background-image: url('https://images.pexels.com/photos/1216589/pexels-photo-1216589.jpeg?auto=compress&cs=tinysrgb&w=1600')"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#141414]/80 via-[#141414]/90 to-[#141414]"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-[3px] bg-primary"></div>
    </Fragment>

    <Fragment slot="title">About Us</Fragment>
    <Fragment slot="subtitle">
      EIKON Guyana Inc. is a registered Guyanese company delivering engineering, construction, and energy solutions to
      private and public sector clients.
    </Fragment>
  </Hero>

  <!-- Company Overview ******************* -->

  <section class="relative not-prose scroll-mt-[72px]">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-900/30 border-t border-gray-200 dark:border-slate-700">
      </div>
    </Fragment>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24">
      <div class="text-center mb-10 md:mb-14">
        <p class="text-primary font-bold tracking-wide uppercase text-sm mb-3">Who We Are</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tighter leading-tighter">
          Innovative Ideas, Solutions &amp; Results
        </h2>
      </div>

      <div class="space-y-6 text-lg leading-relaxed text-default dark:text-slate-300">
        <p>
          EIKON Guyana Inc. provides energy solutions and engineering &amp; construction products and services across
          Guyana. Our work spans eight integrated service lines — from power generation supervision to net-zero building
          design to public infrastructure — covering the full range of Guyana's core infrastructure and energy needs.
        </p>
        <p>
          We serve both private and public sector clients, bringing decades of combined experience in electrical power
          generation, marine analysis, civil works, and renewable energy systems. Our team holds Caterpillar Marine
          Analyst certification, enabling expert-level diagnostics and repair oversight on critical generator
          infrastructure.
        </p>
        <p>
          The company operates under the philosophy <strong>Innovative Ideas, Solutions &amp; Results</strong> — applying
          engineering expertise and rapid-response capability to deliver projects that meet Guyana's national standards and
          climate conditions.
        </p>
      </div>
    </div>
  </section>

  <!-- Company in Practice ******************* -->

  <section
    class="relative not-prose overflow-hidden border-y border-gray-200 bg-white dark:border-slate-700 dark:bg-[#141414]"
  >
    <div class="relative max-w-7xl mx-auto grid md:grid-cols-2 items-stretch">
      <div class="flex flex-col justify-center px-4 sm:px-6 py-16 md:py-24 lg:pr-20">
        <p class="text-primary font-bold tracking-[0.18em] uppercase text-xs mb-3">Company in Practice</p>
        <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tighter leading-tight mb-5">
          Practical thinking for essential work.
        </h2>
        <p class="text-lg text-muted dark:text-slate-400 leading-relaxed mb-7">
          EIKON brings engineering judgment, local understanding, and specialist support together to help clients move
          from an important idea to a working result.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm font-semibold">
          <div class="border-l-2 border-primary pl-3">Plan with purpose</div>
          <div class="border-l-2 border-primary pl-3">Build for conditions</div>
          <div class="border-l-2 border-primary pl-3">Support what lasts</div>
        </div>
      </div>
      <div
        class="min-h-[360px] bg-cover bg-center"
        style="background-image: url('https://images.pexels.com/photos/386236/pexels-photo-386236.jpeg?auto=compress&cs=tinysrgb&w=1400')"
        role="img"
        aria-label="Engineer reviewing technical plans"
      >
      </div>
    </div>
  </section>

  <!-- Leadership ******************* -->

  <section class="relative not-prose scroll-mt-[72px] bg-[#141414]">
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-24">
      <div class="text-center mb-10 md:mb-14">
        <p class="text-primary font-bold tracking-wide uppercase text-sm mb-3">Executive Team</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tighter leading-tighter text-white">
          Leadership with breadth and purpose
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <div class="rounded-lg border border-slate-600 bg-slate-900/50 p-6 md:p-8 text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary mb-6">
            <Icon name="tabler:user" class="w-10 h-10 text-white" />
          </div>
          <h3 class="font-heading text-2xl font-bold text-white mb-2">Ramdeo Kumar</h3>
          <p class="text-primary font-semibold uppercase tracking-wide text-sm mb-4">Co-Chief Executive Officer</p>
          <p class="text-lg text-gray-300 leading-relaxed">
            A finance and audit professional with ACCA qualifications and over 25 years of experience across mining,
            energy, and corporate operations in Guyana. Ramdeo began his career at Ram & McRae as an audit manager
            before serving as Finance Director at Aroaima Mining Company and Representative Officer at UC Rusal. He
            co-leads EIKON Guyana Inc., guiding the company's engineering, construction, and energy operations with a
            strong foundation in financial governance, project oversight, and strategic business development.
          </p>
        </div>

        <div class="rounded-lg border border-slate-600 bg-slate-900/50 p-6 md:p-8 text-center">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary mb-6">
            <Icon name="tabler:user" class="w-10 h-10 text-white" />
          </div>
          <h3 class="font-heading text-2xl font-bold text-white mb-2">Ravie Ramcharitar</h3>
          <p class="text-primary font-semibold uppercase tracking-wide text-sm mb-4">Co-Chief Executive Officer</p>
          <p class="text-lg text-gray-300 leading-relaxed">
            A Chartered Accountant with nearly 30 years of leadership experience across finance, taxation, consultancy,
            pharmaceutical regulatory compliance, and supply chain management. Ravie served as Finance Controller and
            General Manager at a pharmaceutical manufacturing enterprise over a 26-year tenure, overseeing corporate
            administration, operations, and external U.S. FDA audits. He was Chairman of the Demerara Harbour Bridge
            Corporation from 2020 to 2025 and has provided strategic board oversight across power generation,
            healthcare, real estate, distribution, sports, and media.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip ******************* -->

  <section class="relative not-prose scroll-mt-[72px] border-t border-gray-200 dark:border-slate-700">
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12 text-center">
        <div
          class="border-l-2 border-primary pl-5 text-left sm:text-center sm:border-l-0 sm:pl-0 sm:border-b-2 sm:pb-5"
        >
          <div class="font-heading text-4xl md:text-5xl font-bold text-primary">40+</div>
          <div class="text-sm font-medium uppercase tracking-widest text-gray-600 dark:text-slate-400 mt-2">
            Years Combined Experience
          </div>
        </div>
        <div
          class="border-l-2 border-primary pl-5 text-left sm:text-center sm:border-l-0 sm:pl-0 sm:border-b-2 sm:pb-5"
        >
          <div class="font-heading text-4xl md:text-5xl font-bold text-primary">8</div>
          <div class="text-sm font-medium uppercase tracking-widest text-gray-600 dark:text-slate-400 mt-2">
            Integrated Service Lines
          </div>
        </div>
        <div class="border-l-2 border-primary pl-5 text-left sm:text-center sm:border-l-0 sm:pl-0">
          <div class="font-heading text-4xl md:text-5xl font-bold text-primary">100%</div>
          <div class="text-sm font-medium uppercase tracking-widest text-gray-600 dark:text-slate-400 mt-2">
            Guyana-Focused Operations
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA ******************* -->

  <CallToAction id="closing-cta" actions={[{ text: 'Request a Quote', href: '/contact', variant: 'primary' }]}>
    <Fragment slot="title">Let's Build Something That Lasts</Fragment>
    <Fragment slot="subtitle">
      From power generation to road infrastructure to renewable energy — EIKON Guyana Inc. has the engineering expertise
      and rapid-response capability to deliver. Get in touch to discuss your project.
    </Fragment>
  </CallToAction>
</Layout>
