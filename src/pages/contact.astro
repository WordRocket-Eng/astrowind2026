---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactUs
    id="form"
    title="Drop us a message today!"
    subtitle="For quicker answers, explore our FAQs section. You may find the solution you're looking  for right there! If not, our support team is delighted to help you."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="Our support team typically responds within 24 business hours."
  />

  <section
    class="relative not-prose overflow-hidden border-y border-gray-200 bg-[#f7f7f5] dark:border-slate-700 dark:bg-[#181818]"
  >
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <a
          href="tel:+5926233899"
          class="group rounded-2xl bg-white dark:bg-[#141414] border border-gray-200 dark:border-slate-700 p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary dark:hover:border-primary"
        >
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary text-white mb-5"
            ><span class="text-xl">↗</span></span
          >
          <span class="block text-xs font-bold uppercase tracking-[0.18em] text-primary mb-2">Call EIKON</span>
          <span class="block font-heading text-xl font-bold">+592 623 3899</span>
          <span class="mt-2 block text-muted dark:text-slate-400">Talk through your project requirements.</span>
        </a>
        <a
          href="mailto:info@eikongy.com"
          class="group rounded-2xl bg-white dark:bg-[#141414] border border-gray-200 dark:border-slate-700 p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary dark:hover:border-primary"
        >
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary text-white mb-5"
            ><span class="text-xl">@</span></span
          >
          <span class="block text-xs font-bold uppercase tracking-[0.18em] text-primary mb-2">Email Us</span>
          <span class="block font-heading text-xl font-bold break-words">info@eikongy.com</span>
          <span class="mt-2 block text-muted dark:text-slate-400">Send plans, questions, or partnership ideas.</span>
        </a>
        <div class="rounded-2xl bg-white dark:bg-[#141414] border border-gray-200 dark:border-slate-700 p-6 shadow-sm">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary text-white mb-5"
            ><span class="text-xl">⌖</span></span
          >
          <span class="block text-xs font-bold uppercase tracking-[0.18em] text-primary mb-2">Visit EIKON</span>
          <span class="block font-heading text-xl font-bold">Georgetown Office</span>
          <span class="mt-2 block text-muted dark:text-slate-400"
            >127 Quamina &amp; Carmichael Streets, South Cummingsburg.</span
          >
        </div>
      </div>
    </div>
  </section>

  <section class="relative not-prose overflow-hidden bg-[#141414]">
    <div
      class="absolute inset-0 bg-cover bg-center opacity-30"
      style="background-image: url('https://images.pexels.com/photos/532562/pexels-photo-532562.jpeg?auto=compress&cs=tinysrgb&w=1600')"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-[#141414]/75"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-20 text-center text-white">
      <p class="text-primary font-bold tracking-wide uppercase text-sm mb-3">Visit EIKON</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tighter mb-3">
        Let’s Talk About Your Next Project
      </h2>
      <p class="max-w-2xl mx-auto text-lg text-gray-300 leading-relaxed">
        Start a conversation about engineering, construction, energy, or a potential partnership.
      </p>
    </div>
  </section>

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      {
        title: 'Phone',
        description:
          '<div class="space-y-1"><a href="tel:+5926233899" class="block hover:text-primary transition-colors">+592 623 3899</a><a href="tel:+5926239645" class="block hover:text-primary transition-colors">+592 623 9645</a><a href="tel:+5926247471" class="block hover:text-primary transition-colors">+592 624 7471</a></div>',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description:
          '<a href="mailto:info@eikongy.com" class="hover:text-primary transition-colors">info@eikongy.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: '127 Quamina &amp; Carmichael Streets, South Cummingsburg, Georgetown, Guyana',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
