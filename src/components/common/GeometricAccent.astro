---
interface Props {
  variant?: 'full' | 'divider' | 'corner';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
---

{
  variant === 'full' && (
    <svg
      class={`eikon-accent-full ${className}`}
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <clipPath id="eikon-clip-left">
          <polygon points="0,0 360,0 240,120 0,120" />
        </clipPath>
        <clipPath id="eikon-clip-mid">
          <polygon points="300,0 620,0 500,120 180,120" />
        </clipPath>
        <clipPath id="eikon-clip-right">
          <polygon points="560,0 900,0 780,120 420,120" />
        </clipPath>
      </defs>
      <rect x="0" y="0" width="360" height="120" fill="#141414" clip-path="url(#eikon-clip-left)" />
      <rect x="180" y="0" width="440" height="120" fill="#E12D2D" clip-path="url(#eikon-clip-mid)" opacity="0.92" />
      <rect x="420" y="0" width="480" height="120" fill="#878796" clip-path="url(#eikon-clip-right)" opacity="0.5" />
    </svg>
  )
}

{
  variant === 'divider' && (
    <svg
      class={`eikon-accent-divider ${className}`}
      viewBox="0 0 1440 24"
      preserveAspectRatio="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polygon points="0,0 180,0 120,24 0,24" fill="#141414" />
      <polygon points="150,0 330,0 270,24 90,24" fill="#E12D2D" />
      <polygon points="300,0 450,0 390,24 210,24" fill="#878796" opacity="0.55" />
    </svg>
  )
}

{
  variant === 'corner' && (
    <svg
      class={`eikon-accent-corner ${className}`}
      viewBox="0 0 200 200"
      preserveAspectRatio="none"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polygon points="0,0 200,0 140,200 0,200" fill="#141414" />
      <polygon points="80,0 200,0 140,200 60,200" fill="#E12D2D" opacity="0.9" />
      <polygon points="120,0 200,0 170,200 100,200" fill="#878796" opacity="0.4" />
    </svg>
  )
}

<style>
  .eikon-accent-full {
    display: block;
    width: 100%;
    height: auto;
  }

  .eikon-accent-divider {
    display: block;
    width: 100%;
    height: 24px;
  }

  .eikon-accent-corner {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
