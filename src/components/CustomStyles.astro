---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Space Grotesk Variable';

    --aw-color-primary: rgb(225 45 45);
    --aw-color-secondary: rgb(190 30 30);
    --aw-color-accent: rgb(135 135 150);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(20 20 20);
    --aw-color-text-muted: rgb(20 20 20 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(20 20 20);

    ::selection {
      background-color: rgb(225 45 45 / 25%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Space Grotesk Variable';

    --aw-color-primary: rgb(225 45 45);
    --aw-color-secondary: rgb(190 30 30);
    --aw-color-accent: rgb(135 135 150);

    --aw-color-text-heading: rgb(245 245 245);
    --aw-color-text-default: rgb(229 229 229);
    --aw-color-text-muted: rgb(229 229 229 / 66%);
    --aw-color-bg-page: rgb(20 20 20);

    ::selection {
      background-color: rgb(225 45 45 / 40%);
      color: snow;
    }
  }
</style>
